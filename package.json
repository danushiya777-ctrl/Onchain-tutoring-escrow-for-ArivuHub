{
  "name": "onchain-tutoring-escrow-for-arivuhub",
  "version": "1.0.0",
  "description": "Trustless tutoring escrow smart contract for ArivuHub with timeout rules",
  "private": true,
  "scripts": {
    "compile": "cross-env LOCALAPPDATA=.cache hardhat compile",
    "test": "cross-env LOCALAPPDATA=.cache hardhat test",
    "deploy:local": "cross-env LOCALAPPDATA=.cache hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "cross-env LOCALAPPDATA=.cache hardhat run scripts/deploy.ts --network sepolia",
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend build"
  },
  "keywords": [
    "ethereum",
    "solidity",
    "escrow",
    "arivuhub",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.19.43",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.11.1",
    "hardhat": "^2.19.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
