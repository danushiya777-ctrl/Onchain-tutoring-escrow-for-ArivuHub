# Sepolia RPC URL (from Alchemy, Infura, QuickNode, or public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Testnet wallet private key (NEVER use a real wallet with real funds)
# Must start with 0x or will be formatted automatically
PRIVATE_KEY=

# Optional: timeout parameter for deployment script in seconds (default: 300)
ESCROW_TIMEOUT=300

